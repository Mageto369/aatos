NODE_ENV=production
PORT=4000

# Supabase PostgreSQL (use connection pooler for serverless)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Redis (Upstash or Redis Cloud)
REDIS_URL=redis://default:[YOUR-PASSWORD]@[YOUR-REDIS-URL]:6379

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-me-in-production

# AWS S3 (for document storage)
AWS_S3_BUCKET=aatos-staging-documents
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Frontend URL (for CORS)
FRONTEND_URL=https://aatos-staging.vercel.app

# Optional: Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@aatos.africa

# Optional: SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=your-twilio-phone
