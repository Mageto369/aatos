# AATOS Environment Configuration
# Copy this file to .env.local and fill in your values

NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://aatos:aatos_password@localhost:5432/aatos_dev

# Redis (for sessions, caching, rate limiting)
REDIS_URL=redis://localhost:6379

# Encryption key for stored MFA secrets and recovery codes (32+ random chars).
# Falls back to JWT_SECRET when unset, so nothing breaks without it — but set
# it explicitly in production. Rotating either key makes every enrolled MFA
# secret and recovery code permanently undecryptable, by design.
MFA_ENCRYPTION_KEY=your-mfa-encryption-key-min-32-chars

# Flutterwave webhook signing secret, matched against the verif-hash header.
# The webhook endpoint is unauthenticated by necessity — a payment provider
# cannot present a JWT — so this signature is its only authentication. Without
# it the endpoint refuses every delivery rather than trusting unverified
# payment events.
FLUTTERWAVE_WEBHOOK_HASH=your-flutterwave-webhook-hash

# JWT Secrets (generate strong random strings)
JWT_SECRET=your-jwt-secret-key-min-32-chars-long
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars-long

# AWS S3 (for document storage)
AWS_S3_BUCKET=aatos-documents
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Optional: Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@aatos.africa

# Optional: SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=your-twilio-phone

# Pilot Mode
PILOT_MODE=true
PILOT_MAX_ORGS=20
PILOT_COMMODITY_CATEGORY=cat-coffee-green
