{
  "version": 2,
  "github": {
    "enabled": true,
    "autoAlias": true
  },
  "buildCommand": "cd web && npm ci && npm run build",
  "outputDirectory": "web/dist",
  "framework": "vite",
  "installCommand": "cd web && npm ci",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "@aatos_api_url",
    "VITE_WS_URL": "@aatos_ws_url"
  }
}
